{
  "buildCommand": "EXPO_PUBLIC_CHECKOUT_OPEN=1 EXPO_PUBLIC_LIMITS_ENFORCED=1 expo export -p web && node scripts/inject-meta.mjs && node scripts/build-seo-data.mjs",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/og-image-binder.js": {
      "maxDuration": 60
    },
    "api/og-warm.js": {
      "maxDuration": 60
    },
    "api/page-binder.js": {
      "maxDuration": 15,
      "includeFiles": "dist/index.html"
    },
    "api/page-static.js": {
      "maxDuration": 15,
      "includeFiles": "dist/index.html"
    },
    "api/sitemap.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.michi-maker.com"
        }
      ],
      "destination": "https://michi-maker.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "preview.michi-maker.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/binder/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-binder?id=:id"
    },
    {
      "source": "/u/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-profile?id=:id"
    },
    {
      "source": "/michi-method",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-michi"
    },
    {
      "source": "/binder/:id",
      "destination": "/api/page-binder?id=:id"
    },
    {
      "source": "/michi-method",
      "destination": "/api/page-static?route=michi-method"
    },
    {
      "source": "/learn",
      "destination": "/api/page-static?route=learn"
    },
    {
      "source": "/learn/:slug",
      "destination": "/api/page-static?route=learn&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/welcome_v2",
      "destination": "/welcome_v2.html"
    },
    {
      "source": "/auto-fill-methods",
      "destination": "/auto-fill-methods.html"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "development": true
    }
  }
}
