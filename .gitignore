/public/browse/
/public/card-imgs/

# typescript
*.tsbuildinfo

# Visual Studio
.vs/
*.user

example

# generated native folders
/ios
/android
.vercel
.env*

# The real secrets file belongs at the WORKSPACE ROOT (outside every repo).
# Ignored here too, in case a copy is ever dropped into a repo by mistake.
tcgscan.secrets

# Marketing capture working dir: big video intermediates, re-creatable from state/cap-welcome-hero.mjs
state/out/

# Instagram exports (scripts/export-instagram.mjs): generated media, never committed.
state/instagram/
state/seo-shots/

# Community seeding kit (house persona accounts + their shared password): never committed.
state/personas/

state/og-experiment/

# House-binder sync: the @michimaker login only. The script itself is committed.
scripts/house.secrets
state/thirty-live.json

# QA rig run artifacts and browser profiles
qa/runs/
qa/state/

# Connected-artwork import working files: 201 source photographs fetched for card identification
# only, plus the intermediate json. Working files, not product assets, and not ours to redistribute.
state/connected-art/

# Puzzle working files: the contact sheet is a re-creatable check (scripts/presets/rehost-surfaces.mjs)
# and the pair sweep is a long log, neither of which anyone reads from the repo.
state/presets/
state/theme-pairs.log

# Rendered post images: 1.5 MB each and re-creatable by re-running the generator that made them
# (scripts/social/reddit-post.mjs, scripts/social/color-pages.mjs). The markdown beside them, which
# holds the titles, bodies and photographer credits, IS tracked.
state/social/*.jpg
state/social/*.png
