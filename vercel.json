{
  "buildCommand": "EXPO_PUBLIC_CHECKOUT_OPEN=1 EXPO_PUBLIC_TRIALS_OPEN=0 EXPO_PUBLIC_LIMITS_ENFORCED=1 expo export -p web && node scripts/inject-meta.mjs && node scripts/build-seo-data.mjs && node scripts/build-home.mjs && node scripts/build-set-pages.mjs",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/og-image-binder.js": {
      "maxDuration": 120
    },
    "api/og-warm.js": {
      "maxDuration": 120
    },
    "api/og-image-hires.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/og-image-quick.js": {
      "maxDuration": 30
    },
    "api/page-binder.js": {
      "maxDuration": 15,
      "includeFiles": "dist/*.html"
    },
    "api/page-static.js": {
      "maxDuration": 15,
      "includeFiles": "dist/*.html"
    },
    "api/sitemap.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.michi-maker.com"
        }
      ],
      "destination": "https://michi-maker.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.michi-maker.com"
        }
      ],
      "destination": "https://michi-maker.com/:path*",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "preview.michi-maker.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(u/.*|my-binders|lists|purchases|account|studio|subscriptions|wishlist|auth-callback|kit|welcome_v2|app)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/discover",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/discover>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/browse",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/browse>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/whats-new",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/whats-new>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/daily",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/daily>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/contest",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/contest>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/contest-binders",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/contest-binders>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/coverage",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/coverage>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/search-guide",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/search-guide>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/plans",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/plans>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/pricing",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/pricing>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/new-binder",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/new-binder>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/collect",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/collect>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/feedback",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/feedback>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/privacy",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/legal/privacy>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/terms",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/legal/terms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/legal/dmca",
      "headers": [
        {
          "key": "Link",
          "value": "<https://michi-maker.com/legal/dmca>; rel=\"canonical\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "mm_app"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/binder/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-binder?id=:id"
    },
    {
      "source": "/u/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-profile?id=:id"
    },
    {
      "source": "/michi-method",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|Embedly|Iframely|Mastodon|Bluesky|OpenGraph).*"
        }
      ],
      "destination": "/api/og-michi"
    },
    {
      "source": "/binder/:id",
      "destination": "/api/page-binder?id=:id"
    },
    {
      "source": "/michi-method",
      "destination": "/api/page-static?route=michi-method"
    },
    {
      "source": "/learn",
      "destination": "/api/page-static?route=learn"
    },
    {
      "source": "/learn/:slug",
      "destination": "/api/page-static?route=learn&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/welcome_v2",
      "destination": "/welcome_v2"
    },
    {
      "source": "/auto-fill-methods",
      "destination": "/auto-fill-methods"
    },
    {
      "source": "/nine/db/rest/:path*",
      "destination": "https://piikwvntldytjejxmcla.supabase.co/rest/:path*"
    },
    {
      "source": "/nine/cards/storage/:path*",
      "destination": "https://bmhjizcmwtmcrstadqto.supabase.co/storage/:path*"
    },
    {
      "source": "/(browse|collect|contest|contest-binders|coverage|daily|discover|feedback|kit|lists|my-binders|new-binder|plans|pricing|purchases|search-guide|studio|subscriptions|whats-new|wishlist|auth-callback)",
      "destination": "/app"
    },
    {
      "source": "/legal/(privacy|terms|dmca)",
      "destination": "/app"
    },
    {
      "source": "/u/:id",
      "destination": "/app"
    },
    {
      "source": "/sets",
      "destination": "/sets/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/page-static?route=404"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "development": true
    }
  }
}
