# Copy this to the WORKSPACE ROOT as `tcgscan.secrets`:
#     C:\Users\Brian\source\repos\tcgscan\tcgscan.secrets
#
# That folder is not a git repository, so the real file cannot be committed from any repo. That is
# deliberate and stronger than .gitignore: a *.key rule already failed once here when an editor
# saved a service_role key as .key.txt, and it was committed and pushed.
#
# One KEY=value per line. No quotes needed. Values are never printed by the scripts that read them.

# Supabase personal access token, for the CLI (michi-maker/deploy-functions.ps1)
SUPABASE_ACCESS_TOKEN=sbp_...

# New-style API keys. These are NOT JWTs, so rotating the JWT signing key does not invalidate them.
APP_SECRET_KEY=sb_secret_...              # replaces service_role - bypasses RLS, server-side only
APP_PUBLISHABLE_KEY=sb_publishable_...    # replaces anon

# Legacy, only until the rotation is finished. The session tools accept it as a fallback.
# APP_SERVICE_ROLE_KEY=eyJ...
